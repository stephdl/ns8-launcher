# Build launcher/apps.json from the HTTP routes of every Traefik instance
# of the cluster. Run from the module state directory.

import json
import os
import re
import sys
import time
import urllib.request

import agent

APPS_FILE = "launcher/apps.json"
LOGOS_DIR = "launcher/logos"
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$")


def image_name(image_url):
    """ghcr.io/nethserver/mail:1.2.3 -> mail"""
    name = image_url.split("@", 1)[0].rsplit("/", 1)[-1]
    return name.split(":", 1)[0]


def owner_module(instance, module_ids):
    """Map a route instance to the module that created it, like mail1-rspamd -> mail1."""
    if instance in module_ids:
        return instance
    candidates = [mid for mid in module_ids if re.match(re.escape(mid) + r"[-_]", instance)]
    return max(candidates, key=len) if candidates else None


def fetch_logo(image, url):
    """Keep a local copy of the logo so the browser never fetches it from the Internet."""
    filename = image + ".png"
    if not SAFE_NAME.match(filename):
        return ""
    path = os.path.join(LOGOS_DIR, filename)
    if os.path.isfile(path):
        return "/logos/" + filename
    if not url.startswith("https://"):
        return ""
    try:
        with urllib.request.urlopen(url, timeout=10) as response:
            data = response.read(1024 * 1024)
    except Exception as ex:
        print(agent.SD_WARNING + f"Cannot download logo {url}: {ex}", file=sys.stderr)
        return ""
    if not data.startswith(b"\x89PNG"):
        return ""
    with open(path + ".tmp", "wb") as fp:
        fp.write(data)
    os.replace(path + ".tmp", path)
    return "/logos/" + filename


def main():
    rdb = agent.redis_connect()
    module_node = rdb.hgetall("cluster/module_node")
    module_image = {mid: image_name(rdb.hget(f"module/{mid}/environment", "IMAGE_URL") or "") for mid in module_node}
    traefiks = sorted(mid for mid, image in module_image.items() if image == "traefik")

    try:
        with open(APPS_FILE) as fp:
            previous = json.load(fp).get("apps", [])
    except (FileNotFoundError, json.JSONDecodeError):
        previous = []

    repository = {}
    modules_response = agent.tasks.run("cluster", "list-modules", data=None, extra={"isNotificationHidden": True})
    if modules_response["exit_code"] == 0:
        repository = {item["id"]: item for item in modules_response["output"]}
    else:
        print(agent.SD_WARNING + "list-modules failed: names and logos fall back to module IDs", file=sys.stderr)

    tasks = [{"agent_id": f"module/{tid}", "action": "list-routes", "data": {"expand_list": True}} for tid in traefiks]
    try:
        results = agent.tasks.runp(tasks, extra={"isNotificationHidden": True}) if tasks else []
    except Exception as ex:
        # runp raises instead of returning the exception when there is a single task
        results = [ex] * len(tasks)

    apps = []
    for tid, result in zip(traefiks, results):
        if isinstance(result, Exception) or result["exit_code"] != 0:
            # Keep what we knew about this node rather than emptying the page
            print(agent.SD_WARNING + f"list-routes failed on {tid}: keeping its previous apps", file=sys.stderr)
            apps.extend(app for app in previous if app.get("traefik") == tid)
            continue
        for route in result["output"]:
            host = route.get("host")
            instance = route["instance"]
            if not host or instance == os.environ["MODULE_ID"]:
                continue
            module_id = owner_module(instance, module_node)
            image = module_image.get(module_id, "")
            package = repository.get(image, {})
            ui_name = rdb.get(f"module/{module_id}/ui_name") if module_id else None
            apps.append({
                "id": instance,
                "module": module_id or "",
                "name": ui_name or package.get("name") or module_id or host,
                "host": host,
                "url": f"https://{host}{route.get('path', '')}",
                "logo": fetch_logo(image, package.get("logo") or "") if image else "",
                "traefik": tid,
            })

    apps.sort(key=lambda app: app["name"].lower())
    with open(APPS_FILE + ".tmp", "w") as fp:
        json.dump({"updated": int(time.time()), "apps": apps}, fp, indent=2)
    os.replace(APPS_FILE + ".tmp", APPS_FILE)
    print(f"{len(apps)} apps found on {len(traefiks)} traefik instances", file=sys.stderr)


if __name__ == "__main__":
    os.makedirs(LOGOS_DIR, exist_ok=True)
    main()
