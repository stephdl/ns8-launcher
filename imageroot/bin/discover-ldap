import os

from agent.ldapproxy import Ldapproxy

domain = os.environ.get("LDAP_DOMAIN", "")
odom = Ldapproxy().get_domain(domain) if domain else None
if not odom:
    # Public mode, or the domain is not available yet during a restore:
    # point to nowhere, the user-domain-changed event fixes it later.
    odom = {
        "port": 20000,
        "schema": "rfc2307",
        "base_dn": "dc=launcher,dc=invalid",
        "bind_dn": "cn=example,dc=launcher,dc=invalid",
        "bind_password": "invalid",
    }

tmpfile = f"discovery_ldap.env.{os.getpid()}"
with open(tmpfile, "w") as denv:
    os.fchmod(denv.fileno(), 0o600)
    # ldapproxy listens on the node loopback, reachable from slirp4netns as 10.0.2.2
    print("LDAP_HOST=10.0.2.2", file=denv)
    print(f"LDAP_PORT={odom['port']}", file=denv)
    print(f"LDAP_USER={odom['bind_dn']}", file=denv)
    print(f"LDAP_PASS={odom['bind_password']}", file=denv)
    print(f"LDAP_SCHEMA={odom['schema']}", file=denv)
    print(f"LDAP_BASE={odom['base_dn']}", file=denv)
os.replace(tmpfile, "discovery_ldap.env")
