import json
import os
import sys

import agent

event = json.load(sys.stdin)
domain = os.getenv("LDAP_DOMAIN", "")
if not domain or domain not in event.get("domains", [event.get("domain")]):
    sys.exit(0)
if "node_id" in event and str(event["node_id"]) != os.getenv("NODE_ID"):
    sys.exit(0)  # another node's ldapproxy changed

# discover-ldap runs again before the container starts
agent.run_helper("systemctl", "--user", "-T", "try-restart", "launcher.service").check_returncode()
