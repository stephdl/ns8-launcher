{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get launcher configuration",
    "$id": "http://nethserver.org/json-schema/task/output/launcher/get-configuration",
    "examples": [
        {
            "host": "home.domain.org",
            "lets_encrypt": true,
            "auth_mode": "ldap",
            "ldap_domain": "domain.org",
            "ldap_domain_list": ["domain.org"]
        }
    ],
    "type": "object",
    "required": ["host", "lets_encrypt", "auth_mode", "ldap_domain", "ldap_domain_list"],
    "properties": {
        "host": {"type": "string"},
        "lets_encrypt": {"type": "boolean"},
        "auth_mode": {"type": "string", "enum": ["public", "ldap"]},
        "ldap_domain": {"type": "string"},
        "ldap_domain_list": {"type": "array", "items": {"type": "string"}}
    }
}
