import json
import os
import secrets
import sys

import agent

data = json.load(sys.stdin)
ldap_domain = data["ldap_domain"] if data["auth_mode"] == "ldap" else ""

# A user name means someone else in another domain: drop the sessions when it changes
access_changed = (os.environ.get("AUTH_MODE"), os.environ.get("LDAP_DOMAIN", "")) != (data["auth_mode"], ldap_domain)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])
agent.set_env("AUTH_MODE", data["auth_mode"])
agent.set_env("LDAP_DOMAIN", ldap_domain)
agent.bind_user_domains([ldap_domain] if ldap_domain else [])

# Session cookies are signed with this key: keep it out of Redis, which every module can read
if access_changed or not os.path.isfile("session.env"):
    with open("session.env.tmp", "w") as fp:
        os.fchmod(fp.fileno(), 0o600)
        print(f"SESSION_SECRET={secrets.token_hex(32)}", file=fp)
    os.replace("session.env.tmp", "session.env")

os.makedirs("launcher/logos", exist_ok=True)
os.makedirs("launcher/brand", exist_ok=True)
