{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure launcher",
    "$id": "http://nethserver.org/json-schema/task/input/launcher/configure-module",
    "description": "Configure the launcher web page",
    "examples": [
        {
            "host": "home.domain.org",
            "lets_encrypt": true,
            "auth_mode": "ldap",
            "ldap_domain": "domain.org"
        },
        {
            "host": "home.domain.org",
            "lets_encrypt": false,
            "auth_mode": "public",
            "ldap_domain": ""
        }
    ],
    "type": "object",
    "required": [
        "host",
        "lets_encrypt",
        "auth_mode",
        "ldap_domain"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name of the launcher page, like 'home.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "auth_mode": {
            "type": "string",
            "enum": ["public", "ldap"],
            "description": "public: no login, every app is visible. ldap: login required, apps filtered by LDAP groups."
        },
        "ldap_domain": {
            "type": "string",
            "description": "User domain used to log in. Required when auth_mode is ldap."
        }
    },
    "if": {
        "properties": {
            "auth_mode": {
                "const": "ldap"
            }
        }
    },
    "then": {
        "properties": {
            "ldap_domain": {
                "minLength": 1
            }
        }
    }
}
