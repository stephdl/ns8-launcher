import json
import os
import sys


def read_json(path, default):
    try:
        with open(path) as fp:
            return json.load(fp)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


settings = {"welcome": "", "support": {}, "categories": [], "apps": {}, "links": []}
settings.update(read_json("launcher/settings.json", {}))
discovered = read_json("launcher/apps.json", {})

json.dump({
    **settings,
    "logo_set": any(os.path.isfile(f"launcher/brand/logo.{ext}") for ext in ("png", "jpg")),
    "discovered": [
        {key: app.get(key, "") for key in ("id", "module", "name", "host", "url")}
        for app in discovered.get("apps", [])
    ],
    "updated": discovered.get("updated", 0),
}, fp=sys.stdout)
