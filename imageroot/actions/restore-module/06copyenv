import json
import sys

import agent

request = json.load(sys.stdin)
original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "AUTH_MODE",
        "LDAP_DOMAIN",
    ]:
    agent.set_env(evar, original_environment.get(evar, ""))

agent.dump_env()
