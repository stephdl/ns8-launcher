#
# This systemd unit starts the launcher web page using Podman.
#

[Unit]
Description=Launcher web page

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p launcher/logos launcher/brand
ExecStartPre=/bin/rm -f %t/launcher.pid %t/launcher.ctr-id
ExecStartPre=/usr/local/bin/runagent discover-ldap
ExecStart=/usr/bin/podman run --conmon-pidfile %t/launcher.pid \
    --cidfile %t/launcher.ctr-id --cgroups=no-conmon \
    --replace -d --name launcher \
    --publish 127.0.0.1:${TCP_PORT}:8080 \
    --network=slirp4netns:allow_host_loopback=true \
    --env AUTH_MODE \
    --env-file=%S/state/discovery_ldap.env \
    --env-file=%S/state/session.env \
    --volume %S/state/launcher:/data:ro,z \
    ${LAUNCHER_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/launcher.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/launcher.ctr-id
SyslogIdentifier=%N
PIDFile=%t/launcher.pid
Type=forking

[Install]
WantedBy=default.target
